# ERP Raul Castano - Variables de entorno
# Copiar a .env y ajustar valores. Guardar como UTF-8.

# PostgreSQL - Variables separadas (recomendado)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=1234
PGDATABASE=restaurant_erp

# Alternativa: DATABASE_URL (codificar caracteres especiales: o=%C3%B3)
# DATABASE_URL=postgresql://postgres:1234@localhost:5432/restaurant_erp

# Seguridad (cambiar en produccion)
SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria
